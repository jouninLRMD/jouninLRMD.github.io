---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

// Show the three most recent non-draft posts as an entry point from the
// homepage into /blog.
const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });
---
{posts.length > 0 && (
  <section id="blog" class="py-20 bg-white dark:bg-darkCard border-y border-slate-200 dark:border-slate-800 transition-colors">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-12 fade-in">
        <div>
          <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-4">Latest Writing</h2>
          <div class="w-20 h-1 bg-primary rounded-full mb-4"></div>
          <p class="text-slate-600 dark:text-slate-400 max-w-2xl">
            Paper walk-throughs, project notes, and ideas — the story behind the research.
          </p>
        </div>
        <a href="/blog" class="shrink-0 inline-flex items-center px-4 py-2 rounded-lg border border-slate-300 dark:border-slate-600 text-sm font-medium text-slate-700 dark:text-slate-300 hover:border-primary hover:text-primary transition-colors">
          View all posts <span class="ml-1">&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {posts.map((post) => (
          <a href={`/blog/${post.id}`}
             class="group bg-slate-50 dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col fade-in">
            {post.data.cover && (
              <div class="aspect-[16/9] overflow-hidden bg-white dark:bg-slate-900">
                <Image src={post.data.cover} alt={post.data.coverAlt ?? post.data.title}
                       class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500" width={600} />
              </div>
            )}
            <div class="p-6 flex flex-col flex-1">
              <div class="flex items-center gap-2 text-xs mb-3">
                <span class="text-primary font-semibold">{fmt(post.data.date)}</span>
                {post.data.doi && (
                  <span class="inline-block px-2 py-0.5 font-bold uppercase tracking-wide rounded-full bg-primary/10 text-primary">Paper</span>
                )}
              </div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white leading-snug group-hover:text-primary transition-colors">{post.data.title}</h3>
              <p class="text-sm text-slate-600 dark:text-slate-400 mt-2 flex-1">{post.data.description}</p>
              <span class="text-sm font-medium text-primary mt-4 inline-flex items-center">
                Read more <span class="ml-1 group-hover:translate-x-1 transition-transform">&rarr;</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
